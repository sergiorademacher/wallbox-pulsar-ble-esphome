# Copy this file to `secrets.yaml` and fill in your own values.
# secrets.yaml is git-ignored on purpose -- never commit real credentials.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Home Assistant API encryption key.
# Generate one at https://esphome.io/components/api (the "key" field), or run:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_key: "GENERATE_A_32_BYTE_BASE64_KEY"

# OTA update password (any strong string of your choice).
ota_password: "CHOOSE_AN_OTA_PASSWORD"
